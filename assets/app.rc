// Recursos de Xool Files: icono del ejecutable y de la ventana.
1 ICON "assets/xool-files.ico"

LANGUAGE 9, 1
1 VERSIONINFO
FILEVERSION VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,0
PRODUCTVERSION VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Xool Files\0"
            VALUE "CompanyName", "Vyxen Apps\0"
            VALUE "FileVersion", VERSION_TEXT
            VALUE "ProductName", "Xool Files\0"
            VALUE "ProductVersion", VERSION_TEXT
            VALUE "OriginalFilename", "Xool Files.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
